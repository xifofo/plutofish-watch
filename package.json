{
  "name": "plutofish-watch",
  "productName": "PlutoFish Watch",
  "version": "0.1.1",
  "private": true,
  "description": "PlutoFish 目录监控与自动发布客户端",
  "main": "out/main/index.js",
  "author": "PlutoFish",
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/sync-publisher.mjs --check && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "test": "bun test tests",
    "publisher:check": "node scripts/sync-publisher.mjs --check",
    "pack": "pnpm run build && electron-builder --dir",
    "pack:win:x64": "pnpm run build && electron-builder --win nsis --x64 --publish never"
  },
  "pnpm": { "onlyBuiltDependencies": ["electron", "esbuild"] },
  "dependencies": {
    "ali-oss": "6.23.0"
  },
  "devDependencies": {
    "@types/ali-oss": "6.23.3",
    "@types/node": "^24",
    "@vitejs/plugin-vue": "^6",
    "electron": "44.4.5",
    "electron-builder": "^26",
    "electron-vite": "^5",
    "typescript": "^5.9",
    "vite": "^7",
    "vue": "^3.5",
    "vue-tsc": "^3"
  },
  "build": {
    "appId": "app.plutofish.watch",
    "productName": "PlutoFish Watch",
    "directories": { "output": "release" },
    "files": ["out/**", "resources/icon.png", "package.json"],
    "npmRebuild": false,
    "toolsets": { "nsis": "1.2.1" },
    "mac": { "category": "public.app-category.utilities", "identity": null, "icon": "resources/icon.icns" },
    "win": { "target": "nsis", "icon": "resources/icon.ico" },
    "nsis": { "artifactName": "PlutoFish-Watch-${version}-windows-${arch}-setup.${ext}" },
    "linux": { "target": "AppImage", "category": "Utility", "icon": "resources/icon.png" }
  }
}
